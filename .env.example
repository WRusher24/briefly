# --- Required -------------------------------------------------------------
# Neon (or any PostgreSQL) connection string. For Neon use the *pooled* string
# (host contains "-pooler") and keep ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/briefly?sslmode=require"

# Secret used to sign session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=""

# Shared secret that protects /api/cron/refresh. Generate: openssl rand -hex 32
CRON_SECRET=""

# --- Optional -------------------------------------------------------------
# Dedicated key (>= 32 chars) for encrypting users' AI API keys at rest.
# Defaults to a key derived from AUTH_SECRET. Rotating it invalidates stored AI keys.
ENCRYPTION_KEY=""

# Local development only: allow feeds / AI endpoints on localhost or private IPs
# (e.g. a local Ollama server at http://localhost:11434/v1).
ALLOW_PRIVATE_HOSTS="false"
